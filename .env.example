# =============================================================================
# pyATS MCP Server — environment configuration template
# Copy this file to .env and fill in the values for your environment.
# Never commit your actual .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server settings
# -----------------------------------------------------------------------------
PYATS_TESTBED_PATH=/path/to/your/testbed.yaml

# Default: ~/.pyats-mcp/artifacts
PYATS_MCP_ARTIFACTS_DIR=

# "1" = keep test artifacts, "0" = delete after each run. Default: 1
PYATS_MCP_KEEP_ARTIFACTS=1

# Seconds before testbed is reloaded from disk. Default: 30
PYATS_MCP_TESTBED_CACHE_TTL=30

# Seconds to keep device connections alive (0 = reconnect every call). Default: 0
PYATS_MCP_CONN_CACHE_TTL=0

# Max entries in the in-memory operation log. Default: 500
PYATS_MCP_OP_LOG_MAX=500

# -----------------------------------------------------------------------------
# Device credentials
#
# Credentials are defined per device (or shared across a group).
# Reference them in testbed.yaml as: username: "%ENV{DEVICE_USERNAME}"
#
# If a group of devices shares the same credentials, define a group-level var
# and point each device at it — e.g. %ENV{HMETC_USERNAME} for all HMETC devices.
#
# os values    : iosxe | iosxr | nxos | ios | eos | junos | panos | linux | windows
#                Use "generic" to let Unicon autodetect on first connect.
# platform     : CSR1kv | cat9k | asr1k | n9k | vEOS | vmx | ubuntu | alpine
#                Leave blank ("") for autodetect.
# enable       : omit for devices with no enable/privileged mode (Linux, Palo Alto, etc.)
# -----------------------------------------------------------------------------

# -- Shared credential groups (reference these from per-device blocks below) --
# HMETC_USERNAME=changeme
# HMETC_PASSWORD=changeme
# HMETC_ENABLE_PASSWORD=changeme

# NBD_USERNAME=changeme
# NBD_PASSWORD=changeme
# NBD_ENABLE_PASSWORD=changeme

# FIREWALL_USERNAME=changeme
# FIREWALL_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Device definitions — one block per device referenced in testbed.yaml
# Format: {DEVICE_NAME}_{FIELD}=value
# -----------------------------------------------------------------------------

# -- HMETC Region -------------------------------------------------------------
HMETC_CORE1_IP=10.x.x.x
HMETC_CORE1_PORT=22
HMETC_CORE1_OS=iosxe
HMETC_CORE1_PLATFORM=cat9k
HMETC_CORE1_USERNAME=changeme
HMETC_CORE1_PASSWORD=changeme
HMETC_CORE1_ENABLE_PASSWORD=changeme

HMETC_CORE2_IP=10.x.x.x
HMETC_CORE2_PORT=22
HMETC_CORE2_OS=iosxe
HMETC_CORE2_PLATFORM=cat9k
HMETC_CORE2_USERNAME=changeme
HMETC_CORE2_PASSWORD=changeme
HMETC_CORE2_ENABLE_PASSWORD=changeme

HMETC_TOR_SW1_IP=10.x.x.x
HMETC_TOR_SW1_PORT=22
HMETC_TOR_SW1_OS=iosxe
HMETC_TOR_SW1_PLATFORM=
HMETC_TOR_SW1_USERNAME=changeme
HMETC_TOR_SW1_PASSWORD=changeme
HMETC_TOR_SW1_ENABLE_PASSWORD=changeme

# -- NBD Region ---------------------------------------------------------------
HMETC_NBD_CORE1_IP=10.x.x.x
HMETC_NBD_CORE1_PORT=22
HMETC_NBD_CORE1_OS=iosxe
HMETC_NBD_CORE1_PLATFORM=
HMETC_NBD_CORE1_USERNAME=changeme
HMETC_NBD_CORE1_PASSWORD=changeme
HMETC_NBD_CORE1_ENABLE_PASSWORD=changeme

# -- GAD Region ---------------------------------------------------------------
HMETC_GDE_FW_1_IP=10.x.x.x
HMETC_GDE_FW_1_PORT=443
HMETC_GDE_FW_1_OS=panos
HMETC_GDE_FW_1_PLATFORM=
HMETC_GDE_FW_1_USERNAME=changeme
HMETC_GDE_FW_1_PASSWORD=changeme
# (Palo Alto has no enable password)

# -- Firewalls ----------------------------------------------------------------
EU_INT_FW1_IP=10.x.x.x
EU_INT_FW1_PORT=443
EU_INT_FW1_OS=panos
EU_INT_FW1_PLATFORM=
EU_INT_FW1_USERNAME=changeme
EU_INT_FW1_PASSWORD=changeme

# -- Linux / jump hosts -------------------------------------------------------
DESKTOP_IP=10.x.x.x
DESKTOP_PORT=22
DESKTOP_OS=linux
DESKTOP_PLATFORM=ubuntu
DESKTOP_USERNAME=changeme
DESKTOP_PASSWORD=changeme
# (no enable password for Linux)

# -- Autodetect example -------------------------------------------------------
# UNKNOWN_SW_IP=10.x.x.x
# UNKNOWN_SW_PORT=22
# UNKNOWN_SW_OS=generic         ← Unicon will detect the OS on first connect
# UNKNOWN_SW_PLATFORM=          ← leave blank when using generic
# UNKNOWN_SW_USERNAME=changeme
# UNKNOWN_SW_PASSWORD=changeme
# UNKNOWN_SW_ENABLE_PASSWORD=changeme
