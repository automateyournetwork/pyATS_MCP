# =============================================================================
# pyATS MCP Server — environment configuration
# Copy this file to .env and fill in every value for your environment.
# Never commit your actual .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server settings
# -----------------------------------------------------------------------------

# Path to your pyATS testbed YAML file (required)
PYATS_TESTBED_PATH=/path/to/your/testbed.yaml

# Directory where test-run artifacts are stored
# Default: ~/.pyats-mcp/artifacts
PYATS_MCP_ARTIFACTS_DIR=

# Keep artifacts after each run: "1" = keep, "0" = delete
# Default: 1
PYATS_MCP_KEEP_ARTIFACTS=1

# Seconds before the testbed is reloaded from disk
# Default: 30
PYATS_MCP_TESTBED_CACHE_TTL=30

# Seconds to keep device connections alive between calls; 0 = disabled
# Default: 0
PYATS_MCP_CONN_CACHE_TTL=0

# Maximum number of entries kept in the in-memory operation log
# Default: 500
PYATS_MCP_OP_LOG_MAX=500

# -----------------------------------------------------------------------------
# Per-device credentials, IPs, and types
#
# Add one block below for each device defined in your testbed.yaml.
# Every field maps directly to a %ENV{DEVICENAME_VAR} placeholder in that file.
#
# OS values (the OS type — not the version number):
#   iosxe | iosxr | nxos | ios | eos | junos | linux | windows
#   Use "generic" to let Unicon autodetect the OS on first connect
#   (pair with learn_os: true in testbed.yaml for best results).
#
# Platform values (the hardware/VM platform — drives the Unicon plugin):
#   iosxe  → CSR1kv | cat9k | asr1k
#   iosxr  → iosxrv9k | ncs5k | asr9k
#   nxos   → n9k | n7k | n5k
#   eos    → vEOS
#   junos  → vmx | vsrx
#   linux  → ubuntu | alpine | centos
#   Leave blank ("") to let Unicon pick the plugin automatically.
# -----------------------------------------------------------------------------

# -- R1 -----------------------------------------------------------------------
R1_ALIAS=Router01
R1_IP=192.0.2.1
R1_PORT=22
R1_OS=iosxe
R1_PLATFORM=CSR1kv
R1_USERNAME=admin
R1_PASSWORD=changeme
R1_ENABLE_PASSWORD=changeme

# -- SW1 ----------------------------------------------------------------------
SW1_ALIAS=Switch01
SW1_IP=192.0.2.2
SW1_PORT=22
SW1_OS=nxos
SW1_PLATFORM=n9k
SW1_USERNAME=admin
SW1_PASSWORD=changeme
SW1_ENABLE_PASSWORD=changeme

# -- LINUX1 -------------------------------------------------------------------
LINUX1_ALIAS=LinuxHost01
LINUX1_IP=192.0.2.3
LINUX1_PORT=22
LINUX1_OS=linux
LINUX1_PLATFORM=ubuntu
LINUX1_USERNAME=admin
LINUX1_PASSWORD=changeme
# (no enable password for Linux devices)

# -- Autodetect example -------------------------------------------------------
# To let pyATS figure out the OS automatically, set:
#   MYDEVICE_OS=generic
#   MYDEVICE_PLATFORM=
# and uncomment learn_os: true in testbed.yaml for that device.
