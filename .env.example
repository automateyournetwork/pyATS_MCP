# Path to your pyATS testbed YAML file (required)
PYATS_TESTBED_PATH=/path/to/your/testbed.yaml

# Directory where test artifacts are stored (optional)
# Default: ~/.pyats-mcp/artifacts
PYATS_MCP_ARTIFACTS_DIR=

# Set to "1" to keep artifacts after each run, "0" to delete them (optional)
# Default: 1
PYATS_MCP_KEEP_ARTIFACTS=1

# Seconds before the testbed is reloaded from disk (optional)
# Default: 30
PYATS_MCP_TESTBED_CACHE_TTL=30

# Seconds to cache open device connections; 0 disables connection caching (optional)
# Default: 0
PYATS_MCP_CONN_CACHE_TTL=0

# Credentials for devices in testbed.yaml that use %ENV{} substitution
# Example: if your testbed has  password: "%ENV{DEVICE_PASSWORD}"
# DEVICE_USERNAME=admin
# DEVICE_PASSWORD=changeme
