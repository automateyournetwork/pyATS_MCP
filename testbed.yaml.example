# testbed.yaml.example
#
# Copy this file to testbed.yaml and add a matching block for every device
# you want pyATS MCP to manage.  All sensitive values come from your .env
# file via the %ENV{VAR} substitution — nothing is hard-coded here.
#
# See .env.example for the full list of variables and valid os/platform values.
#
---
devices:

  # ── IOS-XE core switch ──────────────────────────────────────────────────────
  HMETC_CORE1:
    alias: "HMETC Core Switch 1"
    type: "switch"
    os: "%ENV{HMETC_CORE1_OS}"
    platform: "%ENV{HMETC_CORE1_PLATFORM}"
    credentials:
      default:
        username: "%ENV{HMETC_CORE1_USERNAME}"
        password: "%ENV{HMETC_CORE1_PASSWORD}"
      enable:
        password: "%ENV{HMETC_CORE1_ENABLE_PASSWORD}"
    connections:
      cli:
        protocol: ssh
        ip: "%ENV{HMETC_CORE1_IP}"
        port: "%ENV{HMETC_CORE1_PORT}"
        arguments:
          connection_timeout: 360

  # ── Palo Alto firewall (no enable password) ──────────────────────────────────
  EU_INT_FW1:
    alias: "EU Internal Firewall 1"
    type: "firewall"
    os: "%ENV{EU_INT_FW1_OS}"
    platform: "%ENV{EU_INT_FW1_PLATFORM}"
    credentials:
      default:
        username: "%ENV{EU_INT_FW1_USERNAME}"
        password: "%ENV{EU_INT_FW1_PASSWORD}"
    connections:
      cli:
        protocol: ssh
        ip: "%ENV{EU_INT_FW1_IP}"
        port: "%ENV{EU_INT_FW1_PORT}"
        arguments:
          connection_timeout: 360

  # ── Linux host (no enable password) ─────────────────────────────────────────
  DESKTOP:
    alias: "Ubuntu Desktop"
    type: "host"
    os: "%ENV{DESKTOP_OS}"
    platform: "%ENV{DESKTOP_PLATFORM}"
    credentials:
      default:
        username: "%ENV{DESKTOP_USERNAME}"
        password: "%ENV{DESKTOP_PASSWORD}"
    connections:
      cli:
        protocol: ssh
        ip: "%ENV{DESKTOP_IP}"
        port: "%ENV{DESKTOP_PORT}"
        arguments:
          connection_timeout: 360

  # ── Unknown / autodetect device ──────────────────────────────────────────────
  # Set UNKNOWN_SW_OS=generic in .env to let Unicon detect the OS automatically.
  # UNKNOWN_SW:
  #   alias: "Unknown Switch"
  #   type: "switch"
  #   os: "%ENV{UNKNOWN_SW_OS}"          # generic
  #   platform: "%ENV{UNKNOWN_SW_PLATFORM}"  # blank
  #   credentials:
  #     default:
  #       username: "%ENV{UNKNOWN_SW_USERNAME}"
  #       password: "%ENV{UNKNOWN_SW_PASSWORD}"
  #     enable:
  #       password: "%ENV{UNKNOWN_SW_ENABLE_PASSWORD}"
  #   connections:
  #     cli:
  #       protocol: ssh
  #       ip: "%ENV{UNKNOWN_SW_IP}"
  #       port: "%ENV{UNKNOWN_SW_PORT}"
  #       arguments:
  #         connection_timeout: 360
  #         learn_os: true   # cache the detected OS after first connect
